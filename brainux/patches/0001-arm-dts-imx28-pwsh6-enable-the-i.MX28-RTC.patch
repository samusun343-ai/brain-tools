From 1d19fca4ac245767a64c5894192bdaf3ec4e1298 Mon Sep 17 00:00:00 2001
From: samusun343-ai <samusun343-ai@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:27:59 +0000
Subject: [PATCH 1/3] arm: dts: imx28-pwsh6: enable the i.MX28 RTC

The distribution device tree leaves the SoC RTC disabled, so
Brainux has no /dev/rtc0 even though mainline ships the
stmp3xxx-rtc driver and brain_defconfig builds it in.

Enable the RTC and mark it as a wakeup source so the RTC alarm
can be used to resume from suspend.
---
 arch/arm/boot/dts/imx28-pwsh6.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm/boot/dts/imx28-pwsh6.dts b/arch/arm/boot/dts/imx28-pwsh6.dts
index 87bd8d028..0400f541e 100644
--- a/arch/arm/boot/dts/imx28-pwsh6.dts
+++ b/arch/arm/boot/dts/imx28-pwsh6.dts
@@ -11,6 +11,11 @@ / {
 	compatible = "sharp,pw-sh6", "sharp,brain", "fsl,imx28";
 };
 
+&mxs_rtc {
+	status = "okay";
+	wakeup-source;
+};
+
 &brainlcd {
 	status = "okay";
 
