 sound/soc/mxs/Kconfig              |   8 +
 sound/soc/mxs/Makefile             |   2 +
 sound/soc/mxs/mxs-bu26154.c        | 172 ++++++++++
 8 files changed, 724 insertions(+), 9 deletions(-)
 create mode 100644 sound/soc/codecs/bu26154.c
 create mode 100644 sound/soc/mxs/mxs-bu26154.c

